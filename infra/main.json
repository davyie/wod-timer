          },
          "acrUsername": {
            "value": "[parameters('acrUsername')]"
          },
          "acrPassword": {
            "value": "[parameters('acrPassword')]"
          },
          "cosmosEndpoint": {
            "value": "[reference(resourceId('Microsoft.Resources/deployments', 'cosmos'), '2025-04-01').outputs.endpoint.value]"
          },
          "cosmosKey": {
            "value": "[parameters('cosmosKey')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "2886625043398816607"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "imageTag": {
              "type": "string"
            },
            "acrLoginServer": {
              "type": "string"
            },
            "acrUsername": {
              "type": "string"
            },
            "acrPassword": {
              "type": "securestring"
            },
            "cosmosEndpoint": {
              "type": "string"
            },
            "cosmosKey": {
              "type": "securestring"
            }
          },
          "resources": [
            {
              "type": "Microsoft.ContainerInstance/containerGroups",
              "apiVersion": "2023-05-01",
              "name": "timer-app",
              "location": "[parameters('location')]",
              "properties": {
                "osType": "Linux",
                "restartPolicy": "Always",
                "imageRegistryCredentials": [
                  {
                    "server": "[parameters('acrLoginServer')]",
                    "username": "[parameters('acrUsername')]",
                    "password": "[parameters('acrPassword')]"
                  }
                ],
                "containers": [
                  {
                    "name": "frontend",
                    "properties": {
                      "image": "[format('{0}/timer-frontend:{1}', parameters('acrLoginServer'), parameters('imageTag'))]",
                      "ports": [
                        {
                          "port": 80,
                          "protocol": "TCP"
                        }
                      ],
                      "resources": {
                        "requests": {
                          "cpu": "[json('0.5')]",
                          "memoryInGB": "[json('0.5')]"
                        }
                      }
                    }
                  },
                  {
                    "name": "backend",
                    "properties": {
                      "image": "[format('{0}/timer-backend:{1}', parameters('acrLoginServer'), parameters('imageTag'))]",
                      "ports": [
                        {
                          "port": 8080,
                          "protocol": "TCP"
                        }
                      ],
                      "resources": {
                        "requests": {
                          "cpu": "[json('1.0')]",
                          "memoryInGB": "[json('1.0')]"
                        }
                      },
                      "environmentVariables": [
                        {
                          "name": "COSMOS_ENDPOINT",
                          "value": "[parameters('cosmosEndpoint')]"
                        },
                        {
                          "name": "COSMOS_KEY",
                          "secureValue": "[parameters('cosmosKey')]"
                        },
                        {
                          "name": "COSMOS_DATABASE",
                          "value": "timer-db"
                        }
                      ]
                    }
                  }
                ],
                "ipAddress": {
                  "type": "Public",
                  "ports": [
                    {
                      "port": 80,
                      "protocol": "TCP"
                    }
                  ],
                  "dnsNameLabel": "[format('timer-app-{0}', uniqueString(resourceGroup().id))]"
                }
              }
            }
          ],
          "outputs": {
            "fqdn": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ContainerInstance/containerGroups', 'timer-app'), '2023-05-01').ipAddress.fqdn]"
            },
            "ip": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ContainerInstance/containerGroups', 'timer-app'), '2023-05-01').ipAddress.ip]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'cosmos')]"
      ]
    }
