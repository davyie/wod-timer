      "value": "[format('http://{0}', reference(resourceId('Microsoft.Resources/deployments', 'aci'), '2025-04-01').outputs.fqdn.value)]"
    },
    "appIp": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'aci'), '2025-04-01').outputs.ip.value]"
